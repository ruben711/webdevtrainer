# ─────────────────────────────────────────────────────────────
# CodeKwartier — environment variables
# Copy to .env.local and fill in. Everything here is OPTIONAL for
# local development: zonder deze waarden draait de app volledig
# lokaal (XP/voortgang in localStorage), enkel server-features
# (leaderboard, sessies, notificaties, admin) zijn dan uit.
# ─────────────────────────────────────────────────────────────

# Upstash Redis — leaderboard / live sessies / notificaties (HTTPS REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login (verborgen /admin pad)
ADMIN_PASSWORD=
ADMIN_SECRET=

# Discord logging (optioneel)
DISCORD_WEBHOOK_URL=
LOG_SECRET=
